# Образец настроек робота-проверяльщика.
# Скопируйте этот файл в tools/live_check.env и впишите свои значения.
# Файл live_check.env в GitHub не попадает (указан в .gitignore).

# С сайта my.telegram.org → API development tools
API_ID=…
API_HASH=…

# Имя Альфреда в Telegram (как в ссылке t.me/…), можно с @
BOT_USERNAME=…

# 1 — после проверки удалить из чата сообщения робота и ответы Альфреда, 0 — оставить
CLEAN_CHAT=1
